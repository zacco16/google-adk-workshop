# Copy this file to `.env` and fill in your key. Never commit the real .env.
#   cp my_travel_planner/.env.example my_travel_planner/.env

# Local Google AI Studio authentication (not Vertex AI).
GOOGLE_GENAI_USE_VERTEXAI=false

# Reserved for a future Vertex AI switch. Setting a location while using an
# AI Studio key makes the Agents CLI request Google Cloud ADC credentials.
VERTEX_AI_LOCATION=us-central1

# Model the agent runs on (see my_travel_planner/agent.py).
GEMINI_MODEL=gemini-2.5-flash

# Your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
